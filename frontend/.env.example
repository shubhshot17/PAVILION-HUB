# Copy to .env.local and set your computer's LAN IP for physical-device testing.
# NEVER use localhost / 127.0.0.1 here — on the phone that means the phone itself.
# Find your IP with: ipconfig   (look for "IPv4 Address" under Wi-Fi)
# VITE_API_URL=http://192.168.1.50:3000/api

# Public address used in share links. Only needed for the Android app — on the
# web the share link uses the address the site is opened from.
# VITE_PUBLIC_URL=https://pavilionhub.example.com
