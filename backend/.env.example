PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# MongoDB Atlas (or local) connection string. Keep the real value only in .env.
# Local default: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Dedicated database for PAVILION HUB — do not reuse another app's database.
MONGODB_DB=pavilion_hub
