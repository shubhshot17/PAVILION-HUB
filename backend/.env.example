PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# MongoDB Atlas (or local) connection string. Keep the real value only in .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Dedicated database for PAVILION HUB — do not reuse another app's database.
MONGODB_DB=pavilion_hub
